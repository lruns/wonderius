{
  "name": "wonderius",
  "private": true,
  "type": "module",
  "description": "Wonderius — an atlas of the world's wonders",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=bundle.js --format=iife --target=es2020 --charset=utf8",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
